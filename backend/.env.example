# Copy this file to .env and fill in your own values.
# .env is ignored by git, so your password never ends up in the repository.

# Port the HTTP server listens on. Optional, defaults to 3000.
PORT=3000

# Origins (scheme, host and port) of the web pages allowed to call the API from a browser,
# separated by commas. Optional, defaults to the Vite dev server: http://localhost:5173
CORS_ORIGINS=http://localhost:5173

DB_HOST=localhost
DB_PORT=5432
DB_NAME=imdb
DB_USER=postgres
DB_PASSWORD=your-password-here

# Secret that signs login tokens. At least 32 characters, random, different for every
# environment, and never committed. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
JWT_SECRET=replace-me-with-the-output-of-the-command-above
