# Copy this file to .env and fill in your own values.
# .env is ignored by git, so your password never ends up in the repository.

# Port the HTTP server listens on. Optional, defaults to 3000.
PORT=3000

# Origins (scheme, host and port) of the web pages allowed to call the API from a browser,
# separated by commas. Optional, defaults to the Vite dev server: http://localhost:5173
CORS_ORIGINS=http://localhost:5173

DB_HOST=localhost
DB_PORT=5432
DB_NAME=imdb
DB_USER=postgres
DB_PASSWORD=your-password-here

# Encrypt the connection to the database (TLS). Optional, defaults to false, which suits a
# PostgreSQL on your own machine. Set it to true for a database on another machine.
DB_SSL=false
# Check the database server's certificate when DB_SSL is true. Optional, defaults to true.
# Set it to false only as a temporary workaround, for example while the server's certificate
# is expired or self-signed: the connection stays encrypted, but the API can no longer tell
# the real server from someone posing as it. Turn it back on once the certificate is fixed.
DB_SSL_VERIFY=true

# Secret that signs login tokens. At least 32 characters, random, different for every
# environment, and never committed. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
JWT_SECRET=replace-me-with-the-output-of-the-command-above
