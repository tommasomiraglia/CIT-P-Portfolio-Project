{
  "name": "cit-portfolio-backend",
  "version": "0.1.0",
  "private": true,
  "description": "RESTful API for the CIT/P portfolio project (Subproject 2)",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc",
    "start": "node dist/server.js",
    "test": "tsc -p test && vitest run",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "db:check": "tsc && node dist/scripts/db-check.js"
  },
  "dependencies": {
    "argon2": "0.45.2",
    "cors": "2.8.6",
    "express": "5.3.0",
    "jose": "6.2.17",
    "pg": "8.23.1"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.2",
    "@types/cors": "2.8.19",
    "@types/express": "5.0.6",
    "@types/node": "24.19.2",
    "@types/pg": "8.23.1",
    "@types/supertest": "7.2.1",
    "supertest": "7.3.1",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "vitest": "5.0.5"
  }
}
